# Copy this file to `.env` and fill in the two values from your Yahoo app.
# See README.md ("One-time Yahoo setup") for where to get them.
#
# `.env` is gitignored. Do not commit it.

YAHOO_CONSUMER_KEY=paste-your-client-id-here
YAHOO_CONSUMER_SECRET=paste-your-client-secret-here

# The values below are written automatically after your first successful login.
# Leave them out of this file; they will be appended to `.env` for you.
# YAHOO_ACCESS_TOKEN=
# YAHOO_REFRESH_TOKEN=
# YAHOO_TOKEN_TYPE=
# YAHOO_TOKEN_TIME=
# YAHOO_GUID=
